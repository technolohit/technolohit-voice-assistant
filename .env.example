# =============================================================================
# TechnoloHit Voice Assistant - .env template
# Copy to .env and fill secrets. Never commit .env.
# =============================================================================

# --- Remote Postgres admin path (SSH from your developer machine) ------------
# Used by: npm run check:db-env, db:migrate:voice, db:test:voice,
# and db:migrate:knowledge. The repo should not live on the DB server.
DB_SSH_HOST=85.215.211.72
DB_SSH_USER=moji
DB_SSH_PORT=22
DB_SSH_KEY_PATH=~/.ssh/id_ed25519
DB_DOCKER_CONTAINER=central_postgres
DB_NAME=technolohit_growth
DB_ADMIN_USER=postgres
# Optional: DB_REMOTE_TMP_DIR=/tmp/th-voice-migrations
# Optional: DB_USE_SCP=false

# --- Voice Assistant DB role (schema voice) ----------------------------------
VOICE_DB_USER=technolohit_voice_app
VOICE_DB_PASSWORD=

# --- voice-bridge runtime ----------------------------------------------------
VOICE_DB_HOST=10.20.0.1
VOICE_DB_PORT=5432
VOICE_DB_NAME=technolohit_growth
VOICE_DB_SSL=false
VOICE_BRIDGE_HOST=0.0.0.0
VOICE_BRIDGE_PORT=9092
VOICE_GREETING_MODE=file
VOICE_GREETING_FILE=/app/audio/greeting.slin
VOICE_RECORDING_ENABLED=true
VOICE_RECORDING_MAX_SECONDS=300
VOICE_RECORDING_DIR=/app/recordings
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_TRANSCRIPTION_LANGUAGE=de
VOICE_TRANSCRIPTION_PROMPT=
OPENAI_API_KEY=

# Controlled turn-based assistant.
VOICE_ASSISTANT_ENABLED=false
VOICE_TURN_LISTEN_SECONDS=5
VOICE_ASSISTANT_MIN_LISTEN_MS=2500
VOICE_ASSISTANT_MAX_LISTEN_MS=10000
VOICE_ASSISTANT_END_SILENCE_MS=900
VOICE_ASSISTANT_MODEL=gpt-4o-mini
VOICE_ASSISTANT_TTS_MODEL=gpt-4o-mini-tts
VOICE_ASSISTANT_TTS_VOICE=marin
VOICE_ASSISTANT_MAX_RESPONSE_CHARS=180
VOICE_ASSISTANT_MAX_RESPONSE_SENTENCES=2
VOICE_ASSISTANT_MAX_TURNS=3
VOICE_ASSISTANT_MAX_TURNS_WITH_INTAKE=5
VOICE_ASSISTANT_END_ON_SILENCE=true
VOICE_ASSISTANT_MIN_TRANSCRIPT_CHARS=5
VOICE_LOG_TRANSCRIPT_PREVIEW=false

# Optional semantic RAG fallback. Keep disabled until pgvector/RAG QA is green.
VOICE_RAG_ENABLED=false
VOICE_RAG_API_URL=http://technolohit-rag-api:8080
VOICE_RAG_TIMEOUT_MS=700
VOICE_RAG_MIN_SCORE=0.72
VOICE_RAG_QA_MODE=false
VOICE_RAG_QA_TIMEOUT_MS=1200
VOICE_RAG_QA_RETRY_DELTA=0.08
VOICE_RAG_QA_ACCEPT_FLOOR=0.65
VOICE_QA_LOG_TRANSCRIPT_PREVIEW=false

# --- RAG API runtime ---------------------------------------------------------
RAG_DB_HOST=10.20.0.1
RAG_DB_PORT=5432
RAG_DB_NAME=technolohit_growth
RAG_DB_USER=technolohit_rag_app
RAG_DB_PASSWORD=
RAG_DB_SSL=false
RAG_DB_STATEMENT_TIMEOUT_MS=500
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_DEFAULT_TENANT_ID=technolohit
RAG_DEFAULT_LANGUAGE=de
RAG_DEFAULT_TOP_K=3
RAG_DEFAULT_MIN_SCORE=0.72
RAG_EXACT_PRODUCT_BOOST=0.03
RAG_SEMANTIC_PRODUCT_BOOST=0.04
RAG_RETRIEVE_CANDIDATE_LIMIT=12
RAG_SEMANTIC_PRODUCT_ACCEPT_FLOOR=0.66
RAG_LOG_QUERY_PREVIEW=false
# Required before running npm run db:migrate:knowledge against production.
PRODUCTION_PGVECTOR_READY=false

# --- Asterisk / Easybell registration keeper --------------------------------
EASYBELL_REGISTRATION_NAME=easybell-registration
EASYBELL_REG_KEEPER_INTERVAL=60
EASYBELL_FORCE_REREGISTER_EVERY=240

# --- Docker image release/deploy --------------------------------------------
VOICE_DOCKER_IMAGE=thnhit/technhvoice
# VOICE_BRIDGE_IMAGE=thnhit/technhvoice:voice-bridge-<git-short-sha>
# RAG_API_IMAGE=thnhit/technhvoice:rag-api-<git-short-sha>
