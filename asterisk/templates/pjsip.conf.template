[global]
type=global
user_agent=TechnoloHit-Asterisk

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[easybell-auth]
type=auth
auth_type=userpass
username=${EASYBELL_SIP_USER}
password=${EASYBELL_SIP_PASSWORD}

[easybell-aor]
type=aor
contact=sip:${EASYBELL_REGISTRAR}

[easybell-registration]
type=registration
transport=transport-udp
outbound_auth=easybell-auth
server_uri=sip:${EASYBELL_REGISTRAR}
client_uri=sip:${EASYBELL_SIP_USER}@${EASYBELL_REGISTRAR}
contact_user=${EASYBELL_CONTACT_USER}
retry_interval=30
forbidden_retry_interval=60
fatal_retry_interval=60
max_retries=10000
expiration=300
line=yes
support_path=yes
endpoint=easybell-endpoint

[easybell-endpoint]
type=endpoint
transport=transport-udp
context=from-easybell
disallow=all
allow=alaw,ulaw,g722
outbound_auth=easybell-auth
; Intentionally no inbound auth=... here.
; Easybell outbound registration uses outbound_auth above, but inbound INVITEs
; are identified by provider IP via [easybell-identify]. Requiring digest auth
; on inbound INVITEs causes "Failed to authenticate" and blocks calls.
aors=easybell-aor
from_user=${EASYBELL_SIP_USER}
from_domain=${EASYBELL_REGISTRAR}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
identify_by=ip

[easybell-identify]
type=identify
endpoint=easybell-endpoint
match=${EASYBELL_REGISTRAR}
