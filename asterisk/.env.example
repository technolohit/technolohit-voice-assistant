# TechnoloHit Asterisk — template defaults (committed).
# SIP credentials and registrar values are set in the deployment secret/env source only.
# Do not commit EASYBELL_SIP_USER, EASYBELL_SIP_PASSWORD, or live contact_user values.

# --- Registration keeper (see docs/asterisk-easybell-registration.md) ---
EASYBELL_REGISTRATION_NAME=easybell-registration
EASYBELL_REG_KEEPER_INTERVAL=60
EASYBELL_FORCE_REREGISTER_EVERY=240

# --- Used by pjsip.conf.template at container start (deploy env only) ---
# EASYBELL_SIP_USER=
# EASYBELL_SIP_PASSWORD=
# EASYBELL_REGISTRAR=
# EASYBELL_CONTACT_USER=
