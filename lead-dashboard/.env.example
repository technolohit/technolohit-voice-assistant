# TechnoloHit Lead Dashboard
# Do not commit real secrets.

LEAD_DASHBOARD_ENV=production
LEAD_DASHBOARD_BIND_HOST=10.20.0.1
LEAD_DASHBOARD_PORT=8090
LEAD_DASHBOARD_APP_BASE_URL=http://10.20.0.1:8090

# Preferred if the container can resolve central_postgres on the selected Docker network:
LEAD_DASHBOARD_DATABASE_URL=postgresql://technolohit_lead_dashboard_app:REPLACE_ME@central_postgres:5432/technolohit_growth

# Fallback if Docker DNS is not available:
# LEAD_DASHBOARD_DATABASE_URL=postgresql://technolohit_lead_dashboard_app:REPLACE_ME@10.20.0.1:5432/technolohit_growth

LEAD_DASHBOARD_USER=admin
LEAD_DASHBOARD_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH

# Optional only for local development. Prefer LEAD_DASHBOARD_PASSWORD_HASH in production.
# LEAD_DASHBOARD_PASSWORD=dev-password

LEAD_DASHBOARD_IMAGE=thnhit/thn-dashbrd:lead-dashboard-v0.1.0

LEAD_DASHBOARD_DOCKER_NETWORK=central-postgres_default
