{
  "name": "technolohit-voice-bridge",
  "version": "1.0.0",
  "description": "TechnoloHit Voice Assistant — AudioSocket bridge with Postgres persistence",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "qa:dialogue": "node scripts/qa-dialogue-text.js",
    "eval:asr-fixture": "node scripts/eval-asr-fixture.js",
    "test": "node --test tests/*.test.js",
    "stt:preflight": "node scripts/openai-stt-preflight.js",
    "rag:canary-preflight": "node scripts/rag-canary-preflight.js",
    "rag:retrieve-preflight": "node scripts/rag-retrieve-preflight.js",
    "rag:retrieve-diagnostics": "node scripts/rag-retrieve-diagnostics.js",
    "rag:live-path-preflight": "node scripts/rag-live-path-preflight.js",
    "compose:runtime-preflight": "node scripts/compose-runtime-preflight.js",
    "compose:baseline-preflight": "node scripts/compose-runtime-preflight.js --baseline",
    "test:intelligence": "node --test tests/intelligence-upgrade.test.js",
    "tts:greeting": "node scripts/generate-greeting-openai.js",
    "audio:convert": "sh scripts/convert-greeting.sh",
    "audio:build": "npm run tts:greeting && npm run audio:convert",
    "playbook:publish-validate": "node scripts/playbook-publish-validate.js --mode=candidate --playbook=config/playbooks/technolohit.main_voice_sales.v1.publish-candidate.json",
    "playbook:publish-validate:published": "node scripts/playbook-publish-validate.js --mode=published --playbook=config/playbooks/technolohit.main_voice_sales.v1.published.json",
    "playbook:canary-preflight": "node scripts/playbook-canary-preflight.js",
    "playbook:canary-artifact-validate": "node scripts/playbook-canary-artifact-validate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^6.38.0",
    "pg": "^8.13.1"
  },
  "license": "UNLICENSED"
}
