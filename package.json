{
  "name": "technolohit-voice-assistant",
  "version": "0.1.0",
  "description": "TechnoloHit Asterisk, voice-bridge, and RAG services for the live phone assistant.",
  "private": true,
  "type": "module",
  "scripts": {
    "check:db-env": "node scripts/db/check-db-env.js",
